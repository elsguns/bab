<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- A separate t-options-* attribute instead of rewriting t-options, so it
         combines with other modules that change the options of the same
         address; high priority so it is applied after a module that replaces
         the node. -->
    <template id="report_delivery_document" inherit_id="stock.report_delivery_document" priority="99">
        <xpath expr="//div[@name='partner_header']//div[@t-field='partner.commercial_partner_id']" position="attributes">
            <attribute name="t-options-bab_customer_code">True</attribute>
        </xpath>
    </template>
</odoo>
