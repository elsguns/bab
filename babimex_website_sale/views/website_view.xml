<odoo>

    <record id="view_website_form" model="ir.ui.view">
        <field name="name">website.form.inherit</field>
        <field name="model">website</field>
        <field name="inherit_id" ref="website.view_website_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='default_lang_id']" position="after">
                <field name="show_line_subtotals_tax_selection_public_user"/>
                <field name="show_line_subtotals_tax_selection_log_in_user"/>
            </xpath>
        </field>
    </record>

</odoo>
