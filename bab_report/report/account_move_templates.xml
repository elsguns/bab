<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Address blocks: a separate t-options-* attribute instead of rewriting
         t-options, so it combines with other changes to the same address; high
         priority so it is applied after a view that replaces the node. -->
    <template id="report_invoice_document" inherit_id="account.report_invoice_document" priority="99">
        <xpath expr="//div[@name='address_not_same_as_shipping']//address[@t-field='o.partner_id']" position="attributes">
            <attribute name="t-options-bab_customer_code">o.is_sale_document()</attribute>
        </xpath>
        <xpath expr="//div[@name='address_same_as_shipping']//address[@t-field='o.partner_id']" position="attributes">
            <attribute name="t-options-bab_customer_code">o.is_sale_document()</attribute>
        </xpath>
        <xpath expr="//div[@name='no_shipping']//address[@t-field='o.partner_id']" position="attributes">
            <attribute name="t-options-bab_customer_code">o.is_sale_document()</attribute>
        </xpath>
    </template>
</odoo>
