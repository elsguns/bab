<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Dedicated paperformat: NO top/bottom margin so the printable area is the
        full A4 height (297mm). The page is meant to be physically cut into three
        equal strips of 99mm, so we want each block to coincide exactly with a
        physical third; any top margin would shift the blocks off the cut lines
        (99mm / 198mm). Left/right margins stay for horizontal framing. The company
        default is unusable here as it reserves ~52mm at the top for the external
        layout header/logo, which we don't render.
    -->
    <record id="paperformat_productmatrix" model="report.paperformat">
        <field name="name">Productenmatrix A4</field>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">0</field>
        <field name="margin_bottom">0</field>
        <field name="margin_left">10</field>
        <field name="margin_right">10</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <!-- dpi 96 (not the usual 90): Odoo passes a "zoom = 96/dpi" flag to
             wkhtmltopdf, so dpi 90 would enlarge everything 1.067x and our mm thirds
             overflow. dpi 96 gives zoom 1.0, so mm renders 1:1. -->
        <field name="dpi">96</field>
        <!-- Critical: wkhtmltopdf's smart shrinking (on by default) scales the whole
             page ~0.8x, so absolute mm heights render short and the thirds don't fill
             the sheet. Disabling it makes mm accurate, so 3 x 99mm = 297mm fills the
             A4 exactly. (Odoo's own label/badge reports do the same.) -->
        <field name="disable_shrinking" eval="True"/>
    </record>

    <!--
        Standalone "Productenmatrix" delivery report.

        Deliberately does NOT reuse stock.report_delivery_document: that template
        is shared with the standard "Delivery Slip" and carries (a) the company
        header/logo/footer via web.external_layout and (b) the standard product
        move list. We want neither here, so we build our own document. The STANDARD
        "Delivery Slip" therefore stays exactly as Odoo ships it.

        Layout: one block per variant matrix. Each block is exactly one physical
        third of the A4 (99mm) so the sheet can be cut into three equal strips, each
        a self-contained slip with its own Customer + Order heading. Blocks pack
        three to a page; a 4th+ flows onto the next page, again in thirds
        (page-break-inside: avoid keeps a block whole).

        The blocks come from stock.picking._get_matrix_blocks() over ALL selected
        deliveries, sorted by hoofdproduct, so a bulk print groups the matrices per
        product instead of per customer/delivery (the headings still tell you which
        delivery each block belongs to). Each grid is rendered as a single matrix
        table, reusing product_matrix.extra_price exactly as Odoo's own
        product_matrix.matrix template does.

        The 99mm height is only accurate because the paperformat disables wkhtmltopdf
        smart shrinking (see paperformat_productmatrix); otherwise mm units render
        ~0.8x and the thirds wouldn't fill the sheet.
    -->
    <template id="report_deliveryslip_matrix">
        <t t-call="web.basic_layout">
            <!-- Zero the report wrappers' vertical spacing so block 1 starts at the very
                 top of the sheet; otherwise a ~6mm offset pushes the thirds down and the
                 last block spills onto a second page. -->
            <style>
                .o_body_html, #wrapwrap, main, .article { margin-top: 0; margin-bottom: 0; padding-top: 0; padding-bottom: 0; }
                /* Explicit borders in a real mm width: Bootstrap's table-bordered draws
                   ~1px (sub-pixel at 96dpi with smart-shrinking off) lines that poppler
                   (GNOME Document Viewer/Evince) drops while Chrome's PDFium still shows
                   them. A defined 0.3mm border renders in every PDF viewer. */
                table.o_product_variant_grid { border-collapse: collapse; }
                table.o_product_variant_grid th,
                table.o_product_variant_grid td { border: 0.3mm solid #000 !important; }
                /* Default look: roomy cells for the common case (up to ~10 colour rows),
                   which keeps the matrix readable in a 99mm strip. */
                .o_matrix_block { font-size: 10pt; line-height: 1.25; }
                .o_matrix_head { margin-bottom: 1.5mm !important; }
                table.o_product_variant_grid th,
                table.o_product_variant_grid td { padding: 0.9mm 1.8mm; }
                /* Auto-shrink: a product with many colours (>10 rows) would overflow the
                   99mm strip at the roomy size, so such blocks fall back to a smaller font
                   and tighter padding to fit (handles the rare 13-20 colour products).
                   Set on the block via o_matrix_block_compact, see the foreach below. */
                .o_matrix_block_compact { font-size: 8pt; line-height: 1.1; }
                .o_matrix_block_compact table.o_product_variant_grid th,
                .o_matrix_block_compact table.o_product_variant_grid td { padding: 0.15mm 1.2mm; }
                /* Equal, fixed-width size columns wide enough for the widest value
                   (164/170); the product-name column absorbs the remaining width, so
                   the size columns stay the same width across every product. All
                   header cells bold; product name left-aligned, size headers centered. */
                table.o_product_variant_grid { table-layout: fixed; width: 100%; }
                table.o_product_variant_grid th { font-weight: bold; }
                table.o_product_variant_grid th:first-child { text-align: left; }
                table.o_product_variant_grid th:not(:first-child),
                table.o_product_variant_grid td:not(:first-child) { width: 13mm; }
                table.o_product_variant_grid th:not(:first-child) { text-align: center; }
            </style>
            <!-- One continuous stream of blocks across ALL selected deliveries, sorted by
                 hoofdproduct (see stock.picking._get_matrix_blocks): a bulk print groups
                 the matrices per product instead of per customer/delivery. Blocks pack
                 three to a page regardless of which delivery they belong to. -->
            <t t-set="blocks" t-value="docs._get_matrix_blocks()"/>
            <t t-foreach="blocks" t-as="block">
                <t t-set="picking" t-value="block['picking']"/>
                <t t-set="grid" t-value="block['grid']"/>
                <!-- One physical third of the A4 (297/3); the sheet is cut at 99mm and
                     198mm into three equal strips. Padding keeps content off the cut
                     lines; never split a block across pages. Start a fresh page on each
                     new hoofdproduct (but not before the very first block). Blocks with
                     more than 10 colour rows get the compact style so they still fit. -->
                <div t-attf-class="o_matrix_block{{ ' o_matrix_block_compact' if len(grid['matrix']) > 10 else '' }}"
                     t-attf-style="height: 99mm; box-sizing: border-box; padding: 8mm 0 6mm; overflow: hidden; page-break-inside: avoid;{{ ' page-break-before: always;' if (block['new_product'] and not block_first) else '' }}">
                    <!-- Customer + Order heading, repeated per block (= per matrix). -->
                    <div class="o_matrix_head row mb-3">
                        <div t-if="picking.partner_id" class="col-4 mw-100" name="div_customer">
                            <strong>Customer</strong>
                            <!-- stock_location shown before the customer name, bold between square
                                 brackets (e.g. [200] Customer 2), only when it carries a value so we
                                 don't print a bare "[]". -->
                            <div>
                                <t t-if="picking.partner_id.stock_location"><strong>[<span t-out="picking.partner_id.stock_location"/>]</strong> </t>
                                <span t-out="picking.partner_id.name">Customer 1</span>
                            </div>
                        </div>
                        <!-- Picking name dropped as a big title; shown in parentheses after the order.
                             Wider (col-8) than the customer column because a grouped delivery can carry
                             dozens of source orders; even so, a long list would make this heading taller
                             than the 99mm block and overlap the next slip, so the order list is capped
                             and truncated with "..." (the picking name always stays visible after it). -->
                        <div t-if="picking.origin" class="col-8 mw-100" name="div_origin">
                            <strong>Order</strong>
                            <!-- picking.origin is the space-joined source order names (merged by
                                 stock_picking_group_by_partner_by_carrier); show at most origin_cap. -->
                            <t t-set="origins" t-value="(picking.origin or '').split()"/>
                            <t t-set="origin_cap" t-value="12"/>
                            <div class="m-0">
                                <span t-out="' '.join(origins[:origin_cap])">S0001</span><t t-if="len(origins) &gt; origin_cap"> ...</t>
                                <span> (<span t-out="picking.name">WH/OUT/0001</span>)</span>
                            </div>
                        </div>
                    </div>
                    <!-- Single matrix table for this grid (mirrors product_matrix.matrix). -->
                    <table class="o_view_grid o_product_variant_grid table table-sm table-striped table-bordered">
                        <thead>
                            <tr>
                                <th t-foreach="grid['header']" t-as="column_header" class="o_grid_title_header">
                                    <span t-esc="column_header['name']">Column name</span>
                                    <!-- After the hoofdproduct name (first header cell) the total ordered
                                         quantity of this grid, separated by two (non-breaking) spaces and
                                         shown bold between square brackets with "stuks", e.g. [18 stuks]. -->
                                    <t t-if="column_header_first and 'total_qty' in grid"><span>&#160;&#160;</span><strong>[<span t-esc="grid['total_qty']" t-options='{"widget": "integer"}'>0</span> stuks]</strong></t>
                                    <t t-call="product_matrix.extra_price">
                                        <t t-set="price" t-value="column_header.get('price', False)"/>
                                    </t>
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="grid['matrix']" t-as="row">
                                <td t-foreach="row" t-as="cell" t-if="cell.get('name', False)" class="text-start">
                                    <strong t-esc="cell['name']">Cell name</strong>
                                    <t t-call="product_matrix.extra_price">
                                        <t t-set="price" t-value="cell.get('price', False)"/>
                                    </t>
                                </td>
                                <td t-else="" class="text-end">
                                    <!-- Quantities as whole numbers on the report; a 0 (no qty ordered
                                         for that size/colour combo) is left blank rather than printing
                                         "0", so the matrix only shows the cells that were actually ordered. -->
                                    <span t-if="cell.get('qty')" t-out="cell.get('qty', 0)" t-options='{"widget": "integer"}'
                                          class="o_grid_cell_container"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </t>
        </t>
    </template>

    <!--
        The Productenmatrix report. Deliberately NOT bound to the Print menu
        (no binding_model_id): printing must go through the "* Productenmatrix"
        server action below, which warns on a reprint. A direct Print-menu entry
        would bypass that confirmation, so it is omitted.
    -->
    <record id="action_report_delivery_matrix" model="ir.actions.report">
        <field name="name">Productenmatrix</field>
        <field name="model">stock.picking</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">bab_stock_delivery.report_deliveryslip_matrix</field>
        <field name="report_file">bab_stock_delivery.report_deliveryslip_matrix</field>
        <field name="print_report_name">'Productenmatrix - %s - %s' % (object.partner_id.name or '', object.name)</field>
        <field name="paperformat_id" ref="paperformat_productmatrix"/>
        <!-- Explicitly clear any binding: this report was previously bound to the
             Print menu, and a module update would NOT reset a removed field, so the
             stale Print entry would survive. Printing now goes via the server action. -->
        <field name="binding_model_id" eval="False"/>
    </record>

    <!--
        Action-menu (cog) entry that drives printing. It runs on a single
        delivery and on a multi-selection from the list, and delegates to
        stock.picking.action_print_matrix, which prints straight away the first
        time and pops a confirmation wizard on a reprint. Name starts with "* "
        to set it apart from stock Odoo actions.
    -->
    <record id="action_print_matrix_server" model="ir.actions.server">
        <field name="name">* Productenmatrix</field>
        <field name="model_id" ref="stock.model_stock_picking"/>
        <field name="binding_model_id" ref="stock.model_stock_picking"/>
        <field name="binding_type">action</field>
        <field name="state">code</field>
        <field name="code">action = records.action_print_matrix()</field>
    </record>
</odoo>
