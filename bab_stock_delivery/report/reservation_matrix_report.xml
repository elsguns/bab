<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Landscape A4 for the reservation matrix: a hoofdproduct block is a
        colours (rows) x sizes (columns) grid where every cell carries three
        numbers, which is wider than tall, so landscape gives the size columns
        room. Standard company margins/header (a normal office overview).
    -->
    <record id="paperformat_reservation_matrix" model="report.paperformat">
        <field name="name">Productenmatrix met reservaties A4 landscape</field>
        <field name="format">A4</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">12</field>
        <field name="margin_bottom">12</field>
        <field name="margin_left">7</field>
        <field name="margin_right">7</field>
        <field name="dpi">90</field>
    </record>

    <!--
        "Productenmatrix met reservaties".

        One block per hoofdproduct, summed over ALL selected transfers (see
        stock.picking._get_reservation_matrix_blocks): rows are the colours,
        columns the sizes (maat). Each cell shows three figures for that
        template+colour+size variant:
          1. reserved quantity on the selected transfers (black);
          2. ONE signed figure: shortage -(demand - reserved) in red when the
             demand is not fully reserved, otherwise surplus +free stock in green
             (the two never appear together);
          3. incoming (forecasted inbound) quantity +N in blue.
        Separated by a pipe. Printable as often as needed (no reprint guard).
    -->
    <template id="report_reservation_matrix">
        <!-- web.basic_layout drops the company external header/footer; it already
             includes web.html_container, so it is the only wrapper needed. -->
        <t t-call="web.basic_layout">
            <div class="page">
                <style>
                    table.o_reservation_grid { border-collapse: collapse; table-layout: fixed; width: 100%; }
                    table.o_reservation_grid th,
                    table.o_reservation_grid td { border: 0.3mm solid #000 !important; padding: 0.8mm 1.6mm; }
                    table.o_reservation_grid th { font-weight: bold; text-align: center; }
                    /* Colour column takes the slack; size columns are narrow now the
                       three figures are stacked vertically (one per line). */
                    table.o_reservation_grid th:first-child,
                    table.o_reservation_grid td:first-child { text-align: left; }
                    table.o_reservation_grid th:not(:first-child),
                    table.o_reservation_grid td:not(:first-child) { width: 16mm; text-align: center; vertical-align: top; }
                    /* Keep the size label (e.g. 50/56) on a single line. */
                    table.o_reservation_grid th:not(:first-child) { white-space: nowrap; }
                    /* r/s/i guide column: its own narrow column, sitting just before
                       the first size column, letters right against that border. Its
                       LEFT border (between Kleur and the guide) is dropped so r/s/i
                       reads as a bare guide; the line after it (before the first size
                       column) stays. */
                    table.o_reservation_grid th.o_res_guide,
                    table.o_reservation_grid td.o_res_guide { width: 6mm !important; text-align: right; border-left: none !important; }
                    table.o_reservation_grid th:first-child,
                    table.o_reservation_grid td:first-child { border-right: none !important; }
                    .o_reservation_block { page-break-inside: avoid; margin-bottom: 6mm; }
                    /* The three stacked cell figures, one per line. Reserved stays
                       the default black; shortage red, surplus green, incoming blue.
                       Each line reserves a fixed sign slot and a right-aligned number
                       slot, so the digits line up and the +/- hangs in front of them. */
                    .o_res_line { line-height: 1.15; white-space: nowrap; }
                    .o_res_sign { display: inline-block; width: 2mm; text-align: right; }
                    .o_res_val  { display: inline-block; min-width: 4mm; text-align: right; }
                    .o_res_shortage { color: #dc3545; }
                    .o_res_surplus  { color: #198754; }
                    .o_res_received,
                    .o_res_incoming { color: #0d6efd; }
                    /* r/s/i guide letters + legend markers, black. */
                    .o_res_lbl { color: #000; font-weight: bold; }
                    /* Legend explaining the r/s/i labels, once at the top. */
                    .o_res_legend { font-size: 9pt; margin-bottom: 4mm; }
                </style>

                <p class="o_res_legend">
                    <span class="o_res_lbl">o</span> = <span class="o_res_received">ontvangen (van de aanvoer)</span> &#160;·&#160;
                    <span class="o_res_lbl">r</span> = gereserveerd &#160;·&#160;
                    <span class="o_res_lbl">s</span> = <span class="o_res_surplus">+overschot (vrije voorraad)</span> / <span class="o_res_shortage">−tekort</span> &#160;·&#160;
                    <span class="o_res_lbl">i</span> = <span class="o_res_incoming">inkomend</span>
                </p>

                <t t-if="not blocks">
                    <p>Geen gereserveerde productvarianten in de selectie.</p>
                </t>

                <!-- One grid per hoofdproduct, already sorted by product. -->
                <div t-foreach="blocks" t-as="block" class="o_reservation_block">
                    <h4 class="mb-2"><span t-out="block['template'].display_name">Hoofdproduct</span></h4>
                    <table class="o_reservation_grid table table-sm">
                        <thead>
                            <tr>
                                <th>Kleur</th>
                                <!-- Narrow guide column carrying the r/s/i letters, just
                                     before the first size column. -->
                                <th class="o_res_guide"/>
                                <th t-foreach="block['sizes']" t-as="size" t-out="size['name']">Maat</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="block['rows']" t-as="row">
                                <td><span t-out="row['colour_name']">Kleur</span></td>
                                <!-- r/s/i guide, one letter per stacked line, black, on
                                     the same three baselines as every size cell. -->
                                <td class="o_res_guide">
                                    <div class="o_res_line o_res_lbl">o</div>
                                    <div class="o_res_line o_res_lbl">r</div>
                                    <div class="o_res_line o_res_lbl">s</div>
                                    <div class="o_res_line o_res_lbl">i</div>
                                </td>
                                <!-- Each populated cell stacks its four figures, one per
                                     line, digits right-aligned with a fixed sign slot so
                                     they never shift: received so far of the supply behind
                                     these transfers (o, black, no sign); reserved (r,
                                     black, no sign); then a
                                     single shortage/surplus figure (s): a red -tekort when
                                     the demand is not fully reserved, otherwise a green
                                     +overschot (+0 when exactly reserved, no free stock);
                                     then incoming (i, blue, no sign since it is always +).
                                     An empty (unordered) combination stays blank. -->
                                <td t-foreach="row['cells']" t-as="cell">
                                    <t t-if="cell">
                                        <!-- Every zero is left blank; the line itself stays so the four
                                             r/s/i baselines still line up across all cells. -->
                                        <div class="o_res_line">
                                            <span class="o_res_sign"/><span class="o_res_val o_res_received" t-if="cell['received']" t-out="cell['received']" t-options='{"widget": "integer"}'/>
                                        </div>
                                        <div class="o_res_line">
                                            <span class="o_res_sign"/><span class="o_res_val" t-if="cell['reserved']" t-out="cell['reserved']" t-options='{"widget": "integer"}'/>
                                        </div>
                                        <div class="o_res_line">
                                            <t t-if="cell['shortage']">
                                                <span class="o_res_sign o_res_shortage">−</span><span class="o_res_val o_res_shortage" t-out="cell['shortage']" t-options='{"widget": "integer"}'/>
                                            </t>
                                            <t t-elif="cell['surplus']">
                                                <span class="o_res_sign o_res_surplus">+</span><span class="o_res_val o_res_surplus" t-out="cell['surplus']" t-options='{"widget": "integer"}'/>
                                            </t>
                                        </div>
                                        <div class="o_res_line">
                                            <span class="o_res_sign"/><span class="o_res_val o_res_incoming" t-if="cell['incoming']" t-out="cell['incoming']" t-options='{"widget": "integer"}'/>
                                        </div>
                                    </t>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </t>
    </template>

    <!--
        The "Productenmatrix met reservaties" report, bound to the Print menu on
        deliveries. Deliberately declared in a data file loaded BEFORE
        product_overview_report.xml so it gets a LOWER ir.actions id than the
        overview report: the Print menu orders report bindings purely by their
        action id (ir.actions.actions._get_bindings sorts reports by id, the
        sequence field only affects the Action/cog menu), so a lower id makes
        this report appear first in Print. product_overview_report.xml then
        re-creates the overview report after this one to keep that order on an
        already-installed database (see the <delete> there).
    -->
    <record id="action_report_reservation_matrix" model="ir.actions.report">
        <field name="name">Productenmatrix met reservaties</field>
        <field name="model">stock.picking</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">bab_stock_delivery.report_reservation_matrix</field>
        <field name="report_file">bab_stock_delivery.report_reservation_matrix</field>
        <field name="print_report_name">'Productenmatrix met reservaties'</field>
        <field name="paperformat_id" ref="paperformat_reservation_matrix"/>
        <field name="binding_model_id" ref="stock.model_stock_picking"/>
        <field name="binding_type">report</field>
    </record>
</odoo>
