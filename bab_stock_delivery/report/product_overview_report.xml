<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Landscape A4 for the overview: a hoofdproduct+kleur block is a
        customers (rows) × sizes (columns) grid, which is wider than tall, so
        landscape gives the size columns room to breathe. Standard company
        margins/header are kept (this is a normal office overview, not a
        cut-into-strips slip like the Productenmatrix).
    -->
    <record id="paperformat_product_overview" model="report.paperformat">
        <field name="name">Productenoverzicht A4 landscape</field>
        <field name="format">A4</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">12</field>
        <field name="margin_bottom">12</field>
        <field name="margin_left">7</field>
        <field name="margin_right">7</field>
        <field name="dpi">90</field>
    </record>

    <!--
        Always-printable "Productenmatrix per kleur en klant".

        One block per hoofdproduct+kleur, summed over ALL selected outgoing
        deliveries (see stock.picking._get_customer_matrix_blocks): rows are the
        customers that ordered, columns are the sizes (maat), cells the ordered
        quantity. Quantities are counted once per sales order, so an order split
        across an original + backorder is not double counted.

        No print-once guard: unlike the Productenmatrix this report is bound to
        the Print menu and may be printed as often as needed.
    -->
    <template id="report_product_overview">
        <!-- web.basic_layout wraps the content WITHOUT the company external header
             and footer (logo / address / page number); web.external_layout would add
             them. basic_layout already includes web.html_container, so it is the only
             wrapper needed here. -->
        <t t-call="web.basic_layout">
                <div class="page">
                    <style>
                        table.o_overview_grid { border-collapse: collapse; table-layout: fixed; width: 100%; }
                        table.o_overview_grid th,
                        table.o_overview_grid td { border: 0.3mm solid #000 !important; padding: 0.8mm 1.6mm; }
                        table.o_overview_grid th { font-weight: bold; text-align: center; vertical-align: top; }
                        /* Customer column takes the slack; size + total columns stay narrow. */
                        table.o_overview_grid th:first-child,
                        table.o_overview_grid td:first-child { text-align: left; }
                        table.o_overview_grid th:not(:first-child),
                        table.o_overview_grid td:not(:first-child) { width: 18mm; text-align: center; vertical-align: top; }
                        /* b/r guide column: its own narrow column just before the first
                           size column; its left border (between Klant and the guide) is
                           dropped so b/r reads as a bare guide, the line after it stays. */
                        table.o_overview_grid th.o_ov_guide,
                        table.o_overview_grid td.o_ov_guide { width: 6mm !important; text-align: right; border-left: none !important; }
                        table.o_overview_grid th:first-child,
                        table.o_overview_grid td:first-child { border-right: none !important; }
                        .o_overview_block { page-break-inside: avoid; margin-bottom: 6mm; }
                        /* Besteld (b) and gereserveerd (r) are stacked one per line now,
                           no longer the reserved figure between brackets. */
                        .o_ov_line { line-height: 1.2; }
                        .o_ov_lbl { color: #000; font-weight: bold; }
                        /* Both figures are coloured by reservation status: green when
                           fully reserved (ordered == reserved), red otherwise (under-
                           reserved or not reserved yet). */
                        .o_match { color: #198754; }
                        .o_mismatch { color: #dc3545; }
                        /* Legend explaining the b/r labels and the colours. */
                        .o_ov_legend { font-size: 9pt; margin-bottom: 4mm; }
                    </style>

                    <t t-if="not blocks">
                        <p>Geen uitgaande leveringen met productvarianten in de selectie.</p>
                    </t>

                    <t t-if="blocks">
                        <p class="o_ov_legend">
                            <span class="o_ov_lbl">b</span> = besteld &#160;·&#160;
                            <span class="o_ov_lbl">r</span> = gereserveerd &#160;·&#160;
                            <span class="o_match">groen</span> = volledig gereserveerd /
                            <span class="o_mismatch">rood</span> = niet volledig
                        </p>
                    </t>

                    <!-- One grid per hoofdproduct+kleur, already sorted by product then colour. -->
                    <div t-foreach="blocks" t-as="block" class="o_overview_block">
                        <h4 class="mb-2">
                            <span t-out="block['template'].display_name">Hoofdproduct</span>
                            <t t-if="block['colour_name']"> — <span t-out="block['colour_name']">kleur</span></t>
                        </h4>
                        <table class="o_overview_grid table table-sm">
                            <thead>
                                <tr>
                                    <th>Klant</th>
                                    <!-- Narrow guide column carrying the b/r letters, just
                                         before the first size column. -->
                                    <th class="o_ov_guide"/>
                                    <th t-foreach="block['sizes']" t-as="size" t-out="size['name']">Maat</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="block['rows']" t-as="row">
                                    <td><span t-out="row['customer'].name">Klant</span></td>
                                    <!-- b/r guide, one letter per stacked line, black, on the
                                         same two baselines as every cell. -->
                                    <td class="o_ov_guide">
                                        <div class="o_ov_line o_ov_lbl">b</div>
                                        <div class="o_ov_line o_ov_lbl">r</div>
                                    </td>
                                    <!-- Each cell stacks besteld (b) over gereserveerd (r), one
                                         per line, no longer bracketed. Both share the same
                                         colour: green when fully reserved (ordered == reserved),
                                         red otherwise. A size the customer ordered always shows
                                         both figures, r included when it is 0 (not yet reserved);
                                         a size that was not ordered at all stays blank. -->
                                    <td t-foreach="row['cells']" t-as="cell">
                                        <t t-set="cls" t-value="'o_match' if cell['ordered'] == cell['reserved'] else 'o_mismatch'"/>
                                        <t t-if="cell['ordered'] or cell['reserved']">
                                            <div class="o_ov_line"><span t-att-class="cls" t-out="cell['ordered']" t-options='{"widget": "integer"}'>0</span></div>
                                            <div class="o_ov_line"><span t-att-class="cls" t-out="cell['reserved']" t-options='{"widget": "integer"}'>0</span></div>
                                        </t>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
        </t>
    </template>

    <!--
        The Productenmatrix per kleur en klant report, bound to the Print menu on deliveries
        (binding_model_id set, binding_type report) so it shows up under Print and
        can be run on a single delivery or a multi-selection. No reprint guard:
        this overview may be printed at will.
    -->
    <!--
        Force this report to be re-created AFTER action_report_reservation_matrix
        so it gets a HIGHER ir.actions id and therefore lands second in the Print
        menu (report bindings are ordered by id, see reservation_matrix_report.xml).
        The search-based delete is a no-op on a fresh install (the report does not
        exist yet when this runs) and, on an upgrade, drops the existing record so
        the <record> below re-creates it with a fresh, higher id than the (already
        created) reservation report. Cascade removes only this report's binding,
        which the re-create restores.
    -->
    <delete model="ir.actions.report"
            search="[('report_name', '=', 'bab_stock_delivery.report_product_overview')]"/>

    <record id="action_report_product_overview" model="ir.actions.report">
        <!-- The report name is the Print-menu label AND, for a multi-record print
             (the usual case here), the PDF filename. So it is kept clean: a leading
             "* " would surface in the menu but also leak into the filename as "_"
             (browsers replace the invalid "*"). -->
        <field name="name">Productenmatrix met reservaties per kleur en klant</field>
        <field name="model">stock.picking</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">bab_stock_delivery.report_product_overview</field>
        <field name="report_file">bab_stock_delivery.report_product_overview</field>
        <field name="print_report_name">'Productenmatrix met reservaties per kleur en klant'</field>
        <field name="paperformat_id" ref="paperformat_product_overview"/>
        <field name="binding_model_id" ref="stock.model_stock_picking"/>
        <field name="binding_type">report</field>
    </record>
</odoo>
