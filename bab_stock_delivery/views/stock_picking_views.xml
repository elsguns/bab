<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Surface the "already printed" flag on the transfer form, in the existing
        "Other Information" group of the Additional Info tab. Read-only (the flag
        is maintained by the report render).

        The Productenmatrix is printed on the warehouse's pick step, whose
        operation type has code 'internal', so that is what we test on
        (picking_type_code is already present, invisible, in that group). There is
        no field on the transfer telling a pick apart from any other internal
        move, so the flag also shows on quality/storage/internal transfers; it
        simply stays unticked there, since only the report ever sets it.
    -->
    <record id="view_picking_form_matrix_printed" model="ir.ui.view">
        <field name="name">stock.picking.form.matrix.printed</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='extra']//field[@name='user_id']" position="after">
                <field name="matrix_printed" invisible="picking_type_code != 'internal'"/>
            </xpath>
        </field>
    </record>
</odoo>
