<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Surface the "already printed" flag on the transfer form, in the existing
        "Other Information" group of the Additional Info tab. Read-only (the flag
        is maintained by the report render).

        The Productenmatrix is printed on the warehouse's pick step, whose
        operation type has code 'internal', so that is what we test on
        (picking_type_code is already present, invisible, in that group). There is
        no field on the transfer telling a pick apart from any other internal
        move, so the flag also shows on quality/storage/internal transfers; it
        simply stays unticked there, since only the report ever sets it.
    -->
    <record id="view_picking_form_matrix_printed" model="ir.ui.view">
        <field name="name">stock.picking.form.matrix.printed</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='extra']//field[@name='user_id']" position="after">
                <field name="matrix_printed" invisible="picking_type_code != 'internal'"/>
            </xpath>
        </field>
    </record>

    <!--
        "Stock" smart button on a done receipt: straight to the stock of the
        received products, where the reservations can be moved between customers
        (Reserved Moves button, when stock_quant_reservation_info is installed).
    -->
    <record id="view_picking_form_received_quants" model="ir.ui.view">
        <field name="name">stock.picking.form.received.quants</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_received_quants" type="object"
                        class="oe_stat_button" icon="fa-cubes" string="Reservations"
                        invisible="state != 'done' or picking_type_code != 'incoming'"
                        groups="stock.group_stock_user"/>
                <!-- Open pick batches with a reservation of the received variants. -->
                <button name="action_open_matrix_pick_batches" type="object"
                        class="oe_stat_button" icon="fa-dropbox"
                        invisible="state != 'done' or picking_type_code != 'incoming' or not matrix_pick_batch_count"
                        groups="stock.group_stock_user">
                    <field name="matrix_pick_batch_count" widget="statinfo" string="Pick batches"/>
                </button>
            </xpath>
        </field>
    </record>

    <!--
        On a done receipt: whether the slips of the pick transfers it fed were
        printed (set by "* Briefjes van de pickbonnen"). Only on receipt types that
        print the slips after a receipt, so the other databases see no change. Next
        to Source Document, so it is seen without opening a tab.
    -->
    <record id="view_picking_form_receipt_slips_printed" model="ir.ui.view">
        <field name="name">stock.picking.form.receipt.slips.printed</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group/field[@name='origin']" position="after">
                <!-- Can only be unticked: that releases the last slips run (see
                     stock.picking.write). Ticking is left to the slips run. -->
                <field name="matrix_printed" string="Slips printed"
                       readonly="not matrix_printed" force_save="1"
                       invisible="not picking_type_auto_print_matrix_after_receipt or state != 'done'"/>
                <field name="picking_type_auto_print_matrix_after_receipt" invisible="1"/>
            </xpath>
        </field>
    </record>


    <!--
        Gear menu of a transfer: only the slip action that fits it (see the
        FormController patch in static/src/picking_form and
        stock.picking.matrix_hidden_action_ids).
    -->
    <record id="view_picking_form_matrix_actions" model="ir.ui.view">
        <field name="name">stock.picking.form.matrix.actions</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <field name="matrix_hidden_action_ids" invisible="1"/>
            </xpath>
        </field>
    </record>
</odoo>
