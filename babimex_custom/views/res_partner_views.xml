<odoo>
    <!-- Inherit Form View to Modify it -->
    <record id="babimex_custom_view_partner_form" model="ir.ui.view">
        <field name="name">babimex.custom.res.partner</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='child_ids']/form//field[@name='mobile']" position="after">
                <field name="is_purchasing_department" widget="boolean_toggle"/>
            </xpath>

            <xpath expr="//div[hasclass('oe_title')]//field[@name='parent_id']/.." position="after">
                <div class="o_row">
                    <field name="commercial_name_id"
                           invisible="company_type != 'company'"
                           placeholder="Commercial Name..."
                           options="{'no_create': True}"/>
                    <div name="parent_commercial_name_id" colspan="2" invisible="is_company or not parent_id">
                        <p>Commercial Names are managed on <button name="open_commercial_entity" type="object" string="the parent company" class="oe_link"/></p>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

    <record id="res_partner_view_search" model="ir.ui.view">
        <field name="name">res.partner.search.inherit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_res_partner_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="commercial_name_id"/>
            </xpath>
            <xpath expr="//group[@name='group_by']" position="inside">
               <filter name="group_commercial_name" string="Commercial Name" context="{'group_by': 'commercial_name_id'}"/>
            </xpath>
        </field>
    </record>
</odoo>
