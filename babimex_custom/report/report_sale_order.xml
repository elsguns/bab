<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="report_saleorder_document_babimex"  inherit_id="sale.report_saleorder_document">
        <xpath expr="//div[@t-field='doc.partner_id']" position="replace">
            <div t-field="doc.partner_id"
                t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": True, "babimex_commercial_name": True}' />
        </xpath>
    </template>
</odoo>