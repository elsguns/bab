<odoo>

    <!-- Products and Product Variants of the Inventory app only: own views
         bound to its actions, so Sales and Purchase keep their order. -->
    <record id="product_template_kanban_view" model="ir.ui.view">
        <field name="name">product.template.kanban.stock.sort</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_kanban_view"/>
        <field name="mode">primary</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <xpath expr="//kanban" position="attributes">
                <attribute name="default_order">stock_sort_key, id</attribute>
            </xpath>
        </field>
    </record>

    <record id="product_template_tree_view" model="ir.ui.view">
        <field name="name">product.template.list.stock.sort</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="mode">primary</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="default_order">stock_sort_key, id</attribute>
            </xpath>
        </field>
    </record>

    <record id="product_template_action_product_kanban" model="ir.actions.act_window.view">
        <field name="sequence">1</field>
        <field name="view_mode">kanban</field>
        <field name="view_id" ref="product_template_kanban_view"/>
        <field name="act_window_id" ref="stock.product_template_action_product"/>
    </record>

    <record id="product_template_action_product_list" model="ir.actions.act_window.view">
        <field name="sequence">2</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="product_template_tree_view"/>
        <field name="act_window_id" ref="stock.product_template_action_product"/>
    </record>

    <record id="product_product_tree_view" model="ir.ui.view">
        <field name="name">product.product.list.stock.sort</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_product_tree_view"/>
        <field name="mode">primary</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="default_order">stock_sort_key, id</attribute>
            </xpath>
        </field>
    </record>

    <record id="product_kanban_view" model="ir.ui.view">
        <field name="name">product.product.kanban.stock.sort</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_kanban_view"/>
        <field name="mode">primary</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <xpath expr="//kanban" position="attributes">
                <attribute name="default_order">stock_sort_key, id</attribute>
            </xpath>
        </field>
    </record>

    <record id="stock_product_normal_action_list" model="ir.actions.act_window.view">
        <field name="sequence">1</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="product_product_tree_view"/>
        <field name="act_window_id" ref="stock.stock_product_normal_action"/>
    </record>

    <record id="stock_product_normal_action_kanban" model="ir.actions.act_window.view">
        <field name="sequence">3</field>
        <field name="view_mode">kanban</field>
        <field name="view_id" ref="product_kanban_view"/>
        <field name="act_window_id" ref="stock.stock_product_normal_action"/>
    </record>

    <!-- Reporting > Stock: a view of the Inventory app itself. -->
    <record id="product_product_stock_tree" model="ir.ui.view">
        <field name="name">product.product.stock.list.sort</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="stock.product_product_stock_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="default_order">stock_sort_key, id</attribute>
            </xpath>
        </field>
    </record>

</odoo>
