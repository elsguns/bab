<odoo>

    <!-- On hand and physical inventory: per location, then product.
         Standard: by product name (product_id) or in order of creation. -->
    <record id="view_stock_quant_tree_inventory_editable" model="ir.ui.view">
        <field name="name">stock.quant.inventory.list.editable.sort</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_tree_inventory_editable"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="default_order">location_id, inventory_date, product_sort_key, package_id, lot_id, owner_id</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_stock_quant_tree_editable" model="ir.ui.view">
        <field name="name">stock.quant.list.editable.sort</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_tree_editable"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="default_order">location_id, product_sort_key, id</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_stock_quant_tree_simple" model="ir.ui.view">
        <field name="name">stock.quant.list.simple.sort</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_tree_simple"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="default_order">location_id, product_sort_key, id</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_stock_quant_tree" model="ir.ui.view">
        <field name="name">stock.quant.list.sort</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="default_order">location_id, product_sort_key, id</attribute>
            </xpath>
        </field>
    </record>

</odoo>
