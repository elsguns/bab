<odoo>

    <!-- The operations of a transfer follow the order of stock.move, which
         this module sets. The detailed operations carry their own order:
         location first, as the route through the warehouse, then the product. -->
    <record id="view_stock_move_line_operation_tree" model="ir.ui.view">
        <field name="name">stock.move.line.operations.list.sort</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_stock_move_line_operation_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="default_order">result_package_id desc, location_id asc, location_dest_id asc, picking_id asc, product_sort_key, id</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_stock_move_line_detailed_operation_tree" model="ir.ui.view">
        <field name="name">stock.move.line.operations.detailed.list.sort</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_stock_move_line_detailed_operation_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="default_order">result_package_id desc, location_id asc, location_dest_id asc, picking_id asc, product_sort_key, id</attribute>
            </xpath>
        </field>
    </record>

</odoo>
